# Copy to .env and fill in. Never commit the real .env file.

# Telegram: create a bot with @BotFather, then message it once (/start)
TELEGRAM_BOT_TOKEN=123456789:AA...
# One or more chat ids, comma separated. Find yours via
# https://api.telegram.org/bot<TOKEN>/getUpdates after sending /start to the bot.
TELEGRAM_CHAT_ID=111111111,222222222

# Librus Synergia accounts (the numeric login + password), one block per student.
# Up to as many as you like: LIBRUS_1_*, LIBRUS_2_*, ... (numbering must have no gaps)
LIBRUS_1_NAME=Anna
LIBRUS_1_LOGIN=1234567
LIBRUS_1_PASSWORD=change-me

#LIBRUS_2_NAME=Ben
#LIBRUS_2_LOGIN=7654321
#LIBRUS_2_PASSWORD=change-me

# Digest language: en or ru (default: ru)
DIGEST_LANGUAGE=en
