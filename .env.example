# Settings. Fill in the values after "=" (no quotes), then save.
# Настройки. Впишите значения после "=" (без кавычек) и сохраните файл.
# Never share this file / Никому не отправляйте этот файл.

# Telegram: token from @BotFather / токен от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Chat ids, comma separated (ask @userinfobot) / номера чатов через запятую
TELEGRAM_CHAT_ID=111111111,222222222

# Librus Synergia: first student / первый ребёнок
LIBRUS_1_NAME=Anna
LIBRUS_1_LOGIN=1234567
LIBRUS_1_PASSWORD=change-me

# More students: remove "#" (numbers without gaps) / ещё дети: уберите "#"
#LIBRUS_2_NAME=Ben
#LIBRUS_2_LOGIN=7654321
#LIBRUS_2_PASSWORD=change-me

# Language / язык сводки: ru or en
DIGEST_LANGUAGE=ru
